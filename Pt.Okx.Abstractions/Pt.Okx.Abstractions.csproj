<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.13.0-beta.1</Version>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    
    <PackageId>Pt.Okx.Abstractions</PackageId>
    <Authors>Platinum Trade</Authors>
    <Company>Platinum Trade</Company>
    <Description>Interface contracts and service abstractions for PlatinumTrade SDK ecosystem.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>okx;trading;crypto;abstractions;interfaces;contracts;dotnet</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet README & Icon -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>

    <!-- Project and Repository URLs -->
    <ProjectUrl>https://github.com/vntradesoft/PlatinumTrade.Abstractions</ProjectUrl>
    <RepositoryUrl>https://github.com/vntradesoft/PlatinumTrade.Abstractions.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Pt.Okx.Shared" Version="0.13.0-beta.1" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />
    <None Include="..\icon.png" Pack="true" PackagePath="\" Link="icon.png" Condition="!Exists('icon.png') And Exists('..\icon.png')" />
    <None Include="..\Pt.Okx.Sdk\icon.png" Pack="true" PackagePath="\" Link="icon.png" Condition="!Exists('icon.png') And !Exists('..\icon.png') And Exists('..\Pt.Okx.Sdk\icon.png')" />
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" Condition="Exists('..\README.md')" />
  </ItemGroup>

</Project>
